      "id": "0d0e20b1-c797-438e-bd13-74022dea3da7",
      "cell_type": "code",
      "source": "//数组扩容\r\nclass ArrayUtil {\r\n    public static int[] grow(int[] oldArray) {\r\n        int newLength = oldArray.length * 2;\r\n        int[] newArray = new int[newLength];\r\n        for (int i = 0; i < oldArray.length; i++) {\r\n            newArray[i] = oldArray[i];\r\n        }\r\n        return newArray;\r\n    }\r\n}",
      "metadata": {
        "language": "java",
