    },
    {
      "id": "44389256-c889-4756-a7d7-85d4477c2dde",
      "cell_type": "code",
      "source": "//数组删除（中间）\r\nint arr[] = {1, 2, 3, 4, 5};\r\nint i=2;\r\nfor(int j=i;j<arr.length-1;j++){\r\n    arr[j]=arr[j++];\r\n}",
