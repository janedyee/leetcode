      "source": "public class ArrayDemo {\r\n    public static void main(String[] args) {\r\n        int[] arr = new int[10];\r\n        arr[0] = 1;\r\n        arr[1] = 2;\r\n        \r\n        int a = arr[1];\r\n        System.out.print(a);\r\n    }\r\n}",
